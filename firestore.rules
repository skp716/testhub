rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       ADMIN CHECK
    ===================================================== */

    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/admin/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admin/$(request.auth.uid)
        ).data.active == true
        && (
          get(
            /databases/$(database)/documents/admin/$(request.auth.uid)
          ).data.role == "admin"
          ||
          get(
            /databases/$(database)/documents/admin/$(request.auth.uid)
          ).data.role == "super_admin"
        );
    }


    /* =====================================================
       ADMIN DOCUMENTS
    ===================================================== */

    match /admin/{uid} {

      allow read: if isAdmin();

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    /* =====================================================
       EXAM CONFIG
    ===================================================== */

    match /exam_config/{configId} {

      /*
        Student needs to read only the active exam configuration.
      */

      allow read: if
        request.auth != null;

      /*
        Only authorized admin can create/update/delete config.
      */

      allow create, update, delete: if isAdmin();
    }


    /* =====================================================
       ATTEMPTS
    ===================================================== */

    match /attempts/{attemptId} {

      /*
        A logged-in student can create his/her own attempt.

        ownerUid must match the authenticated Firebase UID.
      */

      allow create: if
        request.auth != null
        && request.resource.data.ownerUid ==
           request.auth.uid;


      /*
        Student can read only his/her own attempt.
        Admin can read every attempt.
      */

      allow read: if
        isAdmin()
        ||
        (
          request.auth != null
          && resource.data.ownerUid ==
             request.auth.uid
        );


      /*
        Student can update only his/her own attempt.

        This allows the fields used by the current student.js:
        - answers
        - review
        - currentIndex
        - violations
        - violationCount
        - penaltiesApplied
        - questionIds
        - updatedAt
        - submittedAt
        - status
        - resultSummary
        - questionSnapshot

        Admin can update anything.
      */

      allow update: if
        isAdmin()
        ||
        (
          request.auth != null
          && resource.data.ownerUid ==
             request.auth.uid
          && request.resource.data.ownerUid ==
             resource.data.ownerUid
        );


      /*
        Only admin can delete attempts.
      */

      allow delete: if isAdmin();
    }


    /* =====================================================
       RESULTS
    ===================================================== */

    match /results/{resultId} {

      /*
        Student can create only his/her own result.

        ownerUid must match Firebase Auth UID.
      */

      allow create: if
        request.auth != null
        && request.resource.data.ownerUid ==
           request.auth.uid;


      /*
        Student can read only his/her result.
        Admin can read all results.
      */

      allow read: if
        isAdmin()
        ||
        (
          request.auth != null
          && resource.data.ownerUid ==
             request.auth.uid
        );


      /*
        Student can update only his/her own result.

        Required for:
        - rating
        - doubt
        - feedback
        - feedbackAt

        Admin can update anything.
      */

      allow update: if
        isAdmin()
        ||
        (
          request.auth != null
          && resource.data.ownerUid ==
             request.auth.uid
          && request.resource.data.ownerUid ==
             resource.data.ownerUid
        );


      /*
        Only admin can permanently delete results.
      */

      allow delete: if isAdmin();
    }


    /* =====================================================
       DENY EVERYTHING ELSE
    ===================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
