rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/admin/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admin/$(request.auth.uid)
        ).data.active == true
        && (
          get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.role == "admin"
          ||
          get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.role == "super_admin"
        );
    }

    match /admin/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /exam_config/{configId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.ownerUid == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.ownerUid == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
